        {
          "id": "65706fa3-e08a-4328-8315-373ee10d4fd4",
          "name": "Recieve the users notifications.",
          "request": {
            "name": "Recieve the users notifications.",
            "description": {
              "content": "Recieve the users notifications, including edited transcriptions, moderated contributions, and replies to comments. Notifications are contributions, with an additional field 'notificationType' to denote type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                "notifications",
                ":userId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "countOnly",
                  "value": "<boolean>",
                  "description": "Recieve only the count of notifications, and none of the contributions."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Recieve only the notifications past a certain date. Date must be in YYYY-MM-DD format."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<int>",
                  "description": "Limit the amount of returned notifications."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<int>",
                  "description": "Page number for pagination of notifications. Page size is denoted by limit, defaults to 5. For example, if page = 3 notifications 10-14 will be returned."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "userId",
                  "description": "(Required) userId of the user recieving notifications."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "082b56e9-2424-492a-bfd5-13f3e186bde6",
              "name": "Successfully retrieved notifications",
              "originalRequest": {
